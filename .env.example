# Backend selection: ollama | local | huggingface
BACKEND=ollama

# --- Ollama (default) ---
# Runs models locally via Ollama. Install from https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434/v1
AGENT_MODEL=qwen2.5:7b

# --- Local OpenAI-compatible server ---
# Use BACKEND=local for LM Studio, Jan, vLLM, KoboldCPP, llama.cpp, etc.
# BACKEND=local
# LOCAL_BASE_URL=http://localhost:1234/v1
# LOCAL_API_KEY=lm-studio    # optional — most local servers don't require a key
# AGENT_MODEL=your-model-name

# --- Hugging Face (GGUF via llama-cpp-python) ---
# Use BACKEND=huggingface to run GGUF models pulled directly from Hugging Face.
# Requires: pip install llama-cpp-python huggingface_hub
# For GPU support: CMAKE_ARGS="-DGGML_CUDA=on" pip install llama-cpp-python --force-reinstall
#
# BACKEND=huggingface
# HF_TOKEN=hf_xxxxxxxxxxxxxxxx   # optional — only needed for gated/private models
# HF_MODEL_FILE=models/Qwen2.5-7B-Instruct-Q4_K_M.gguf   # path set automatically after download
# N_GPU_LAYERS=0        # 0 = CPU only; set to e.g. 35 to offload layers to GPU
# N_CTX=4096            # context window size
# TEMPERATURE=0.7       # sampling temperature

# --- Email (optional) ---
# Leave blank to disable email tools entirely.
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
IMAP_SERVER=imap.gmail.com
SMTP_SERVER=smtp.gmail.com

# --- Web UI credentials ---
WEB_USERNAME=admin
WEB_PASSWORD=changeme

# --- Misc ---
HEADLESS_MODE=true
