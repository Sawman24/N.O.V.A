# Backend selection: ollama | local
BACKEND=ollama

# --- Ollama (default) ---
# Runs models locally via Ollama. Install from https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434/v1
AGENT_MODEL=qwen2.5:7b

# --- Local OpenAI-compatible server ---
# Use BACKEND=local for LM Studio, Jan, vLLM, KoboldCPP, llama.cpp, etc.
# BACKEND=local
# LOCAL_BASE_URL=http://localhost:1234/v1
# LOCAL_API_KEY=lm-studio    # optional — most local servers don't require a key
# AGENT_MODEL=your-model-name

# --- Email (optional) ---
# Leave blank to disable email tools entirely.
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
IMAP_SERVER=imap.gmail.com
SMTP_SERVER=smtp.gmail.com

# --- Web UI credentials ---
WEB_USERNAME=admin
WEB_PASSWORD=changeme

# --- Misc ---
HEADLESS_MODE=true

